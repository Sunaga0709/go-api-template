SERVER_HOST=server
SERVER_PORT=8080
LOG_LEVEL=info
HIDDEN_SUCCESS_LOG=false
DATABASE_URL="mysql://dbuser:dbpass@tcp(db:3306)/go-api-template?parseTime=true"
TEST_DATABASE_URL="mysql://dbuser:dbpass@tcp(db-test:3306)/go-api-template?parseTime=true&multiStatements=true"

DB_HOST=db
DB_NAME=go-api-template
DB_USERNAME=dbuser
DB_PASSWORD=dbpass
DB_ROOT_PASSWORD=dbrootpass
DB_PORT=3306

TEST_DB_HOST=db-test
TEST_DB_ENGINE=mysql
TEST_DB_NAME=go-api-template-test
TEST_DB_USERNAME=dbuser
TEST_DB_PASSWORD=dbpass
TEST_DB_ROOT_PASSWORD=dbrootpass
TEST_DB_PORT=3307
